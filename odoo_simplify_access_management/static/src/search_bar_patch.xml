<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.SearchBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_searchview')]" position="attributes">
            <attribute name="t-if">this.visibilityState.showSearchBar and this.samSearchAllowed()</attribute>
        </xpath>
    </t>

</templates>
