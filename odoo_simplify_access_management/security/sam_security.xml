<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_sam" model="ir.module.category">
        <field name="name">Access Manage Studio</field>
        <field name="description">Access Manage Studio</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 19: res.groups 不再有 category_id,组通过 res.groups.privilege
         挂到模块分类(privilege.category_id -> ir.module.category) -->
    <record id="res_groups_privilege_sam" model="res.groups.privilege">
        <field name="name">Access Manage Studio</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_sam"/>
    </record>

    <record id="group_sam_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_sam"/>
        <!-- Odoo 19: users 字段改名为 user_ids -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can create and manage Access Manage Studio configurations.</field>
    </record>

</odoo>
